# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead
# (DATABASE_URL is filled in automatically if you use render.yaml).

# Postgres connection string, e.g.:
# postgres://user:password@localhost:5432/aurelia
DATABASE_URL=

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: override the seeded demo account passwords (recommended).
SEED_GUEST_PASSWORD=guest123
SEED_ADMIN_PASSWORD=admin123

# Local Postgres usually doesn't need SSL. Leave unset (or omit) on
# Render, since Render Postgres requires it.
# PGSSL=false

PORT=3000
